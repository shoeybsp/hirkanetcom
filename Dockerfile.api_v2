FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN addgroup --system --gid 10001 app && adduser --system --uid 10001 --ingroup app app
COPY requirements.txt requirements-api_v2.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api_v2.txt
COPY . .
RUN chown -R app:app /app
USER app
EXPOSE 8010
CMD ["uvicorn", "api_v2.main:app", "--host", "0.0.0.0", "--port", "8010"]
