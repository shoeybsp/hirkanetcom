###############################################################################
# Hirkanet environment configuration
#
# Usage:
#   cp hirkanet.env.example .env
#   chmod 600 .env
#
# Generate a separate random value for each secret:
#   openssl rand -hex 32
#
# Security rules:
# - Never commit the real .env file to Git.
# - Never reuse passwords between PostgreSQL, Elasticsearch, Kibana, Logstash,
#   the bootstrap administrator, and Flask SECRET_KEY.
# - Hexadecimal secrets are recommended because they are URL-safe and avoid
#   Docker Compose/shell interpolation problems.
###############################################################################

###############################################################################
# Application runtime
###############################################################################

# Runtime mode. Keep "production" for the Docker/Gunicorn stack.
APP_ENV=production

# Logical service name included in structured application logs.
SERVICE_NAME=hirkanet

# Logging threshold: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Use "json" for Filebeat/Logstash ingestion. Use "text" only for local
# troubleshooting when the ELK pipeline is not required.
LOG_FORMAT=json

# IANA timezone used by the application and containers.
TZ=Europe/Riga

# Flask session/signing secret. Generate with: openssl rand -hex 32
# Do not change this after users have active sessions unless invalidating those
# sessions is acceptable.
SECRET_KEY=c4df91a1a4d01622cab0a9c6089018f58651154aa69bf1f74807c873c3830115

# Maximum uploaded request/file size in bytes. 5242880 = 5 MiB.
MAX_UPLOAD_BYTES=5242880

###############################################################################
# Initial application administrator
###############################################################################

# Created only when the application initializes an empty database and no
# matching administrator already exists.
BOOTSTRAP_ADMIN_USERNAME=hirkanet_admin

# Use a unique, strong password.
# Change or remove this value after the first successful initialization if the
# application no longer needs bootstrap-account creation on startup.
BOOTSTRAP_ADMIN_PASSWORD=a28d620761b09320c4e4f9af23fbdfa35b282b2112856228489537f04916da96

###############################################################################
# PostgreSQL
###############################################################################

# Use lowercase letters, numbers, and underscores only.
# These values initialize PostgreSQL only when postgres_data is empty.
POSTGRES_DB=hirkanet_db
POSTGRES_USER=hirkanet_app

# Generate with: openssl rand -hex 32
# Hex is strongly recommended because Docker Compose inserts this value into
# DATABASE_URL. Characters such as @, :, /, #, %, or ? require URL encoding.
POSTGRES_PASSWORD=ff04bd470c407652e5118016d0bef65b70e31396872992bb621d3b5aa97708ca

# DATABASE_URL is intentionally not defined here. docker-compose.yml builds it:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

###############################################################################
# Elastic Stack image version
###############################################################################

# Keep Elasticsearch, Kibana, Logstash, and Filebeat on exactly the same
# version. This Compose file uses Docker Hub images.
STACK_VERSION=9.3.8

###############################################################################
# Elasticsearch and internal Elastic users
###############################################################################

# Built-in Elasticsearch superuser password.
# Use username "elastic" and this password to sign in to Kibana.
# Generate with: openssl rand -hex 32
ELASTIC_PASSWORD=9b98e7da1723ef8fa7a1063ba47bc41cc27477f6b6f06775f9c43b3c1f333c5d

# Password assigned to the built-in kibana_system account.
# This is only for Kibana-to-Elasticsearch communication.
# Do not use it to sign in to the Kibana UI.
# Generate with: openssl rand -hex 32
KIBANA_PASSWORD=20bee89213b9ed730b78580191867d828a47eac8296cdd2ebd73e49bbf0c9de5

# Password assigned to the logstash_internal account by elastic-init.
# Generate with: openssl rand -hex 32
LOGSTASH_PASSWORD=1940ef87717ce04be3bff7347fb013af0ed939d6efdf73c9f9244b289b74cb78

###############################################################################
# JVM memory
###############################################################################

# Elasticsearch heap. Xms and Xmx should remain equal.
# 512 MiB is a practical minimum for this local development stack.
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# Logstash heap.
LS_JAVA_OPTS="-Xms256m -Xmx256m"

###############################################################################
# Kibana encryption keys
###############################################################################

# Each key must be at least 32 characters and different from all other keys.
# Keep these values stable across restarts.
# Generate each separately with: openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=37c07b9860ae7de307299c3dac7cc3e8aebb342aa1a6965c273789a941d3c01e
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=d70e98e7fd8b8471dcab7577e7507b688dff4cc4c4cd3cf71f6d44b43ffb6cbf
KIBANA_REPORTING_ENCRYPTION_KEY=3232ac426d2d0f9b65cbb0a5e7bf08e2d6d0a665f6cae3fbcb3e06700796d6fd

###############################################################################
# FortiGate collector
###############################################################################

# FortiGate hostname or IP address without a URL path.
# Example: 192.0.2.10 or firewall.example.internal
# Leave empty until the collector is used.
FORTIGATE_HOST=192.168.20.12

# FortiGate REST API token. Treat this as a secret.
FORTIGATE_TOKEN=ae3a2f4a5f

# Normally https. Use http only in an isolated test environment.
FORTIGATE_SCHEME=https

# FortiGate virtual domain.
FORTIGATE_VDOM=root

# Keep true when the FortiGate certificate is trusted and valid.
# For self-signed certificates, install the private CA instead of disabling
# certificate verification.
FORTIGATE_VERIFY_SSL=true

# API request timeout in seconds.
FORTIGATE_TIMEOUT=30

# Output directory inside the application container.
# docker-compose.yml maps ./data to /app/data.
FORTIGATE_OUTPUT_DIR=data

# false collects monitor-route data; true skips the route-monitor endpoint.
FORTIGATE_SKIP_MONITOR_ROUTES=false
