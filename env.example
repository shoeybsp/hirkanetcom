# Hirkanet environment configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# docker-compose.yml loads .env via env_file for the db, migrate, and app
# services. Values are read as plain environment variables (secret_utils.py
# also supports a NAME_FILE variant pointing at a Docker secret file, e.g.
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password - use whichever
# style fits your deployment; .env works fine on its own for local/dev use).
#
# Anything marked (required in production) is enforced only when
# APP_ENV=production; local/dev runs fall back to an insecure default so
# they still start.

# =============================================================================
# Core application
# =============================================================================

# development | production
APP_ENV=development

# Flask session-signing key. (required in production)
SECRET_KEY=change-me-please

# Encrypts device API keys/credentials stored in the devices table
# (see secret_crypto.py). (required in production)
# Losing or rotating this key makes previously stored device credentials
# undecryptable - they will need to be re-entered through the admin UI.
DEVICE_CREDENTIAL_KEY=change-me-please

# Created automatically the first time the app starts if no users exist yet.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# =============================================================================
# Database
# =============================================================================

# Option A: a full SQLAlchemy URL (takes precedence over the Postgres
# settings below if set). Leaving everything in this section unset falls
# back to a local SQLite file (fortigate_policy.db) - fine for local dev,
# not for production.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Option B: discrete Postgres settings (used when DATABASE_URL is unset and
# POSTGRES_HOST is set). Matches docker-compose.yml's db service.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hirkanet
POSTGRES_USER=hirkanet
POSTGRES_PASSWORD=change-me-please

# =============================================================================
# Web server / networking
# =============================================================================

# Comma-separated hostnames Flask will accept in the Host header.
TRUSTED_HOSTS=hirkanet.com,www.hirkanet.com,localhost,127.0.0.1

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-* headers (e.g. the bundled nginx). Leave false otherwise.
TRUST_PROXY_HEADERS=false

# Max request body size in bytes (default: 5 MiB).
MAX_UPLOAD_BYTES=5242880

# =============================================================================
# Login rate limiting
# =============================================================================

LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_USERNAME_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_RETENTION_SECONDS=86400

# =============================================================================
# Logging
# =============================================================================

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# json | plain
LOG_FORMAT=json

# Included in structured log output; useful when aggregating logs from
# multiple services in the ELK stack.
SERVICE_NAME=hirkanet

# =============================================================================
# Legacy single-device FortiGate collector (collectors/fortigate_collector.py)
# =============================================================================
#
# These only apply if you still run the collector standalone (e.g. via cron)
# instead of using the admin panel's per-device inventory and "Sync Now"
# button, which store each device's connection settings in the database
# instead of environment variables.

FORTIGATE_HOST=
FORTIGATE_TOKEN=
FORTIGATE_VDOM=root
FORTIGATE_SCHEME=https
FORTIGATE_VERIFY_SSL=false
FORTIGATE_TIMEOUT=30
FORTIGATE_SKIP_MONITOR_ROUTES=false
FORTIGATE_KEEP_SNAPSHOTS=10
FORTIGATE_OUTPUT_DIR=data

# =============================================================================
# Docker Compose
# =============================================================================

# Which compose file(s) to use, e.g. to include the optional ELK stack:
# COMPOSE_FILE=docker-compose.yml:docker-compose.elastic.yml
